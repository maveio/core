# The installer generates .env with unique secrets. This file documents every
# operator-facing setting; do not use these placeholder secret values.
MAVE_CORE_IMAGE=ghcr.io/maveio/core:0.1.0
MAVE_BASE_URL=http://localhost:4000
MAVE_CADDY_ADDRESS=:80
MAVE_HTTP_PORT=4000
MAVE_HTTPS_PORT=4443
MAVE_MINIO_CONSOLE_PORT=9001
# Change both only if this subnet conflicts with an existing Docker network.
MAVE_DOCKER_SUBNET=172.30.0.0/24
MAVE_CADDY_INTERNAL_IP=172.30.0.254

POSTGRES_PASSWORD=replace-with-random-hex
CLICKHOUSE_PASSWORD=replace-with-random-hex
S3_ACCESS_KEY=replace-with-random-hex
S3_SECRET_KEY=replace-with-random-hex
SECRET_KEY_BASE=replace-with-at-least-64-random-bytes
MAVE_CORE_INTERNAL_SECRET=replace-with-random-hex
MAVE_UPLOAD_HOOK_SECRET=replace-with-random-hex
# Erlang distribution cookie. Anyone who knows it can run code on Core, and
# Core refuses to start without one of at least 32 characters.
RELEASE_COOKIE=replace-with-random-hex

# The installer creates the first owner. Keep public signup disabled unless
# this installation intentionally accepts registrations from the internet.
MAVE_PUBLIC_REGISTRATION_ENABLED=false
MAVE_PUBLIC_REGISTRATION_MAX_USERS=100

# Hard limit per direct or remote media input (20 GiB by default).
MAVE_MEDIA_INPUT_MAX_BYTES=21474836480

# Email is optional because bootstrap prints a one-time owner login link.
# Set the adapter to smtp to enable later magic links and team invitations.
MAVE_MAILER_ADAPTER=none
MAVE_EMAIL_FROM_NAME=Mave
MAVE_EMAIL_FROM_ADDRESS=noreply@localhost
SMTP_RELAY=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=always
SMTP_SSL=false
