#!/bin/sh

# Set the port range for Erlang distribution (used by FLAME)
export ELIXIR_ERL_OPTIONS="-kernel inet_dist_listen_min 9000 inet_dist_listen_max 9100"
export RELEASE_DISTRIBUTION=name

# A node that presents the cookie can run arbitrary code on this one. Never fall
# back to releases/COOKIE: it is fixed at build time, so every installation of
# the same image shares it and anyone with the image can read it.
case "$RELEASE_COMMAND" in
  start|start_iex|daemon|daemon_iex|remote|rpc|restart|stop|pid)
    if [ "${#RELEASE_COOKIE}" -lt 32 ]; then
      echo "RELEASE_COOKIE must be a secret of at least 32 characters shared by every node of this deployment, for example: openssl rand -hex 32" >&2
      exit 1
    fi
    ;;
esac

# Read FLAME Parent IP from mounted file (dynamic per host)
if [ -f /app/mave_private_ip ]; then
  export FLAME_PARENT_IP=$(cat /app/mave_private_ip)
fi
